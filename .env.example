# Server
SERVER_PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SSL_MODE=disable
DB_MAX_CONNS=10

# Auth (JWT)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=720h

# Optional: bootstrap the first admin on startup (all 3 required together)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456